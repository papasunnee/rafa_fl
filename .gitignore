# for reproducibility.
results_test*/
results_debug*/

# Per-run agent/SCAFFOLD state (auto-cleaned after each run; ignore defensively)
.state/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Jupyter / pytest
.ipynb_checkpoints/
.pytest_cache/

# Run logs from experiments.run_all (large; not needed to reproduce tables)
results/_logs/
