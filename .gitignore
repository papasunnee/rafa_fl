# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# Packaging
build/
dist/
*.egg-info/

# Dataset (download separately; see README "Dataset" section)
data/UCI HAR Dataset/

# Throwaway/smoke-test experiment outputs (regenerate via experiments/run_all.py).
